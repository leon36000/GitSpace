{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:gitspace:schema:v1:eval-run-manifest","title":"GitSpace EvalRunManifest v1","type":"object","additionalProperties":false,"required":["id","version","task_id","task_version","agent","environment","execution","artifacts"],"properties":{"id":{"type":"string","pattern":"^GS-RUN-[0-9A-HJKMNP-TV-Z]{26}$"},"version":{"type":"integer","minimum":1},"task_id":{"type":"string","pattern":"^GS-TASK-[0-9]{6}$"},"task_version":{"type":"integer","minimum":1},"agent":{"$ref":"urn:gitspace:schema:v1:agent-configuration"},"environment":{"type":"object","additionalProperties":false,"required":["image_digest","architecture","dependency_lock_digest","network_policy_digest"],"properties":{"image_digest":{"$ref":"#/$defs/digest"},"architecture":{"type":"string","minLength":1},"dependency_lock_digest":{"$ref":"#/$defs/digest"},"network_policy_digest":{"$ref":"#/$defs/digest"}}},"execution":{"type":"object","additionalProperties":false,"required":["seed","started_at","ended_at","interruption_schedule","retries"],"properties":{"seed":{"type":"integer"},"started_at":{"type":"string","minLength":1},"ended_at":{"type":"string","minLength":1},"interruption_schedule":{"type":"array"},"retries":{"type":"integer","minimum":0}}},"artifacts":{"type":"object","additionalProperties":false,"required":["trace","state_before","state_after","patch","evidence_bundle"],"properties":{"trace":{"$ref":"#/$defs/casUri"},"state_before":{"$ref":"#/$defs/casUri"},"state_after":{"$ref":"#/$defs/casUri"},"patch":{"$ref":"#/$defs/casUri"},"evidence_bundle":{"$ref":"#/$defs/casUri"}}},"extensions":{"$ref":"#/$defs/extensions"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"casUri":{"type":"string","pattern":"^cas://sha256/[0-9a-f]{64}$"},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z0-9]+(?:[.-][a-z0-9-]+)+$"},"additionalProperties":true}}}