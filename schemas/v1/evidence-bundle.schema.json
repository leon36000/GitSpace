{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:gitspace:schema:v1:evidence-bundle","title":"GitSpace EvidenceBundle v1","type":"object","additionalProperties":false,"required":["id","version","run_id","task_id","run_manifest_digest","environment_digest","commit_sha","artifacts"],"properties":{"id":{"type":"string","pattern":"^GS-EVIDENCE-[0-9A-HJKMNP-TV-Z]{26}$"},"version":{"type":"integer","minimum":1},"run_id":{"type":"string","pattern":"^GS-RUN-[0-9A-HJKMNP-TV-Z]{26}$"},"task_id":{"type":"string","pattern":"^GS-TASK-[0-9]{6}$"},"run_manifest_digest":{"$ref":"#/$defs/digest"},"environment_digest":{"$ref":"#/$defs/digest"},"commit_sha":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},"artifacts":{"type":"object","minProperties":1,"propertyNames":{"pattern":"^[a-z][a-z0-9_.-]{0,63}$"},"additionalProperties":{"$ref":"#/$defs/casUri"}},"extensions":{"$ref":"#/$defs/extensions"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"casUri":{"type":"string","pattern":"^cas://sha256/[0-9a-f]{64}$"},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z0-9]+(?:[.-][a-z0-9-]+)+$"},"additionalProperties":true,"default":{}}}}