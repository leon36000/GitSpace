{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:gitspace:schema:v1:run-event","title":"GitSpace RunEvent v1","type":"object","additionalProperties":false,"required":["version","run_id","sequence","event_type","occurred_at","payload","payload_digest"],"properties":{"version":{"type":"integer","minimum":1},"run_id":{"type":"string","pattern":"^GS-RUN-[0-9A-HJKMNP-TV-Z]{26}$"},"sequence":{"type":"integer","minimum":0},"event_type":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"},"occurred_at":{"type":"string","minLength":1},"payload":{"type":"object","additionalProperties":true},"payload_digest":{"$ref":"#/$defs/digest"},"extensions":{"$ref":"#/$defs/extensions"}},"$defs":{"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"extensions":{"type":"object","propertyNames":{"pattern":"^[a-z0-9]+(?:[.-][a-z0-9-]+)+$"},"additionalProperties":true,"default":{}}}}